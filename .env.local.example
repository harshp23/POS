# Copy this file to .env.local. .env.local is ignored by Git.
APP_ENV=local
DATA_MODE=local_demo
# The Proviyaa backend (backend/). Empty = fully local demo mode.
#   npm run start:local  → http://localhost:8787 (embedded DB, no Supabase)
#   npm start            → http://localhost:8787 (your Supabase project)
PROVIYAA_API_BASE_URL=http://localhost:8787
SYNC_ENABLED=true

# The app holds NO Supabase URL or key: only the backend talks to Supabase
# (backend/.env). Never put a service-role key, database password, OAuth
# token or MCP credential in this file or in the Flutter application.
