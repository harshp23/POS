# Proviyaa POS backend. Copy to backend/.env (git-ignored).
#
# The backend is the ONLY component that talks to the database. It signs
# users in with master-admin's accounts (the users table, bcrypt passwords)
# and issues the same JWTs master-admin does, so one login works in the
# master panel and in the POS. The Flutter app holds no database URL or key.

PORT=8787

# The same Postgres master-admin uses (Supabase → Project Settings →
# Database → Connection string). A direct db.<ref>.supabase.co URL is
# rewritten to the IPv4 session pooler automatically; set
# SUPABASE_POOLER_HOST if your project's pooler is not aws-0-ap-south-1.
# Keep this file private: it holds the database password.
DATABASE_URL=
DB_POOL_MAX=10

# MUST equal master-admin/backend's JWT_SECRET: tokens from either backend
# are accepted by both.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (the Flutter web build). Comma
# separated; native Windows/Android builds don't need this.
CORS_ORIGINS=http://localhost:8642,http://127.0.0.1:8642

# ── npm run start:local only ───────────────────────────────────────────
# A local Postgres (PGlite) with master-admin's migrations + the live
# schema snapshot + the POS migration. Never contacts Supabase.
LOCAL_DATA_DIR=.data/pglite
LOCAL_DB_PORT=55432
# Seeded on first local start (local only).
LOCAL_PLATFORM_EMAIL=superadmin@onlatur.com
LOCAL_PLATFORM_PASSWORD=Proviyaa@2026
LOCAL_SEED_EMAIL=admin@spicybistro.com
LOCAL_SEED_PASSWORD=SpicyBistro@2026
